{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "davetimhazirxyz",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "davetimhazir.xyz", "custom_domain": true },
    { "pattern": "www.davetimhazir.xyz", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
